<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/weather_widget_background"
    android:padding="12dp">

    <!-- ============================================ -->
    <!-- РЕЖИМ 2x1 (Компактный) -->
    <!-- ============================================ -->
    <LinearLayout
        android:id="@+id/layoutCompact"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="visible">

        <ImageView
            android:id="@+id/iconCompact"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tempCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22°"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cityCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Киев"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================ -->
    <!-- РЕЖИМ 2x2, 3x3 (Квадратный) -->
    <!-- ============================================ -->
    <RelativeLayout
        android:id="@+id/layoutSquare"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iconSquare"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentEnd="true" />

        <TextView
            android:id="@+id/tempSquare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/iconSquare"
            android:layout_marginTop="8dp"
            android:text="22°"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/descSquare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tempSquare"
            android:layout_marginTop="4dp"
            android:text="Переменная облачность"
            android:textColor="#E0E0E0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detailsSquare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/descSquare"
            android:layout_marginTop="4dp"
            android:text="💧 45%  💨 5 км/ч"
            android:textColor="#B0B0B0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/citySquare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="Киев"
            android:textColor="#E0E0E0"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- ============================================ -->
    <!-- РЕЖИМ 2x3, 2x4 (Узкий высокий) -->
    <!-- ============================================ -->
    <LinearLayout
        android:id="@+id/layoutTall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iconTall"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_vertical" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tempTall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22°"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cityTall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Киев"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/descTall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Переменная облачность"
                android:textColor="#E0E0E0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/detailsTall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="💧 45%  💨 5 км/ч"
                android:textColor="#B0B0B0"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================ -->
    <!-- РЕЖИМ 4x2, 5x2, 4x3, 5x3 (Широкий с прогнозом) -->
    <!-- ============================================ -->
    <LinearLayout
        android:id="@+id/layoutWide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Левая половина: текущая погода -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/iconWide"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true" />

            <TextView
                android:id="@+id/tempWide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/descWide"
                android:layout_marginTop="4dp"
                android:text="22°"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/descWide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/detailsWide"
                android:layout_marginTop="2dp"
                android:text="Переменная облачность"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/detailsWide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/cityWide"
                android:layout_marginTop="2dp"
                android:text="💧 45%  💨 5 км/ч"
                android:textColor="#B0B0B0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cityWide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:text="Киев"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Разделитель -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#40FFFFFF" />

        <!-- Правая половина: прогноз -->
        <ListView
            android:id="@+id/forecastList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp" />
    </LinearLayout>

</FrameLayout>